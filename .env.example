# Copy to .env and fill in. .env is used only for bootstrap flags.
# Everything else (site settings, API keys, etc) lives encrypted in core.db,
# managed from the admin UI.

# Required. Random secret used to derive the session-cookie key and the
# settings-encryption key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Optional. Port to listen on. Defaults to 3000.
PORT=3000

# Optional. Set to 1 to force the admin to set a new password at next login.
FORCE_PASSWORD_RESET=0
