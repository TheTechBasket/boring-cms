# yncms bootstrap configuration. Everything else is managed from the admin UI.
#
# SECRET_KEY encrypts stored settings and signs session cookies.
# On a true first boot (no .env at all) yncms generates this file for you.
# Generate manually: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Back it up. Losing it makes encrypted settings unreadable.
SECRET_KEY=

PORT=3000

# Set to 1 to force every user to choose a new password at next login.
FORCE_PASSWORD_RESET=0
