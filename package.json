{
  "name": "boring-cms",
  "version": "0.20.0",
  "description": "Open-source headless CMS. One deploy, many projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheTechBasket/boring-cms.git"
  },
  "homepage": "https://www.npmjs.com/package/boring-cms",
  "keywords": [
    "cms",
    "headless-cms",
    "sqlite",
    "zero-dependencies",
    "mcp",
    "self-hosted"
  ],
  "type": "module",
  "bin": {
    "boring-cms": "bin/boring-cms.js"
  },
  "files": [
    "bin/",
    "server.js",
    "lib/*.js",
    "migrations/",
    "public/",
    ".env.example"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json",
    "postpack": "rm -f server.js lib/*.js",
    "start": "node server.ts",
    "smoke": "node scripts/smoke.ts",
    "verify:pack": "node scripts/verify-pack.ts",
    "css": "tailwindcss -i styles/admin.src.css -o public/admin.css --minify",
    "css:watch": "tailwindcss -i styles/admin.src.css -o public/admin.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.4.1",
    "marked": "^18.0.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
